# Baukontext klein halten: nur mvnw, .mvn/, pom.xml, src/ und vorlagen/ werden
# gebraucht (siehe Dockerfile). Ohne diese Datei landen target/ und bin/ im
# Kontext und machen jeden Build unnötig langsam.
target/
bin/
.idea/
# Der Wrapper ist "only-script" (distributionType in maven-wrapper.properties),
# eine maven-wrapper.jar wird nicht gebraucht; das Skript selbst und
# .mvn/wrapper/maven-wrapper.properties MÜSSEN im Kontext bleiben.
.mvn/wrapper/maven-wrapper.jar
node_modules/
package.json
package-lock.json
vite.generated.ts
# Vaadin erzeugt das Frontend-Tooling im Image-Build neu
src/main/resources/frontend/generated/
*.iml
.DS_Store
.project
.classpath
.settings/
.git/
.gitignore

# Betriebs-/Analyse-Artefakte gehören nicht ins Image
# (die DB-Skripte unter src/main/resources/db/init werden nur vom
#  docker-compose-Stack gemountet und sind per pom.xml aus dem Artefakt
#  ausgeschlossen – sie bleiben im Baukontext, schaden dort aber nicht)
ops/
docker-compose*.yml
Dockerfile
README.md
test-config.env
