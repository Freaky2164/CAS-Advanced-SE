# Build-Artefakte
target/
bin/
*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDE / OS
.idea/
*.iml
.settings/
.classpath
.DS_Store

# Vaadin erzeugt sein Frontend-Tooling beim Build selbst (prepare-frontend /
# build-frontend). Diese Dateien gehoeren daher NICHT ins Repository - sie
# waeren nur eine veraltete Kopie des generierten Zustands.
# Das Frontend-Verzeichnis liegt hier unter src/main/resources/frontend
# (siehe vaadin.frontend.directory in der pom.xml), nicht im Vaadin-Standardpfad.
node_modules/
package.json
package-lock.json
pnpm-lock.yaml
vite.generated.ts
types.d.ts
tsconfig.json
src/main/resources/frontend/generated/
src/main/bundles/

# Lokale Konfiguration / Secrets - niemals einchecken
.env
test-config.env

# Fachliche Word-Vorlagen kommen von der Vorlagen-Gruppe (siehe README)
vorlagen/*.dot
vorlagen/*.doc
