<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>de.frauenhaus</groupId>
    <artifactId>frauenhaus-backend</artifactId>
    <version>1.0.0</version>
    <name>Frauenhaus Verwaltung Backend</name>
    <description>Adress-, Spenden- und Bussgeldverwaltung (Neubau, ehemals Compucrash)</description>

    <properties>
        <java.version>25</java.version>
        <poi.version>5.5.1</poi.version>
        <vaadin.version>25.2.3</vaadin.version>
        <!-- Vaadin-Frontend-Quellen (index.html, generated/) liegen bewusst nicht im
             Standardpfad src/main/frontend, sondern bei den übrigen Nicht-Java-Quellen
             unter src/main/resources. Wird vom vaadin-maven-plugin ausgewertet. -->
        <vaadin.frontend.directory>${project.basedir}/src/main/resources/frontend</vaadin.frontend.directory>

        <jacoco.version>0.8.14</jacoco.version>
        <sonar.scanner.version>5.1.0.4751</sonar.scanner.version>

        <!-- Statische Analyse: lokale SonarQube aus docker-compose.sonarqube.yml.
             Der Token kommt zur Laufzeit (-Dsonar.token=... bzw. SONAR_TOKEN), niemals aus dem Repo. -->
        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <sonar.projectKey>frauenhaus-backend</sonar.projectKey>
        <sonar.projectName>Frauenhaus Verwaltung Backend</sonar.projectName>
        <sonar.sources>src/main/java</sonar.sources>
        <sonar.tests>src/test/java</sonar.tests>
        <!-- Testabdeckung aus dem JaCoCo-XML-Report (siehe jacoco-maven-plugin unten) -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Generiertes Vaadin-Frontend und DB-Skripte sind kein zu bewertender Java-Quellcode -->
        <sonar.exclusions>target/**,src/main/resources/frontend/**,node_modules/**</sonar.exclusions>
        <!-- Die Vaadin-Views sind reine UI-Verdrahtung und werden manuell abgenommen;
             sie würden die Coverage der fachlich relevanten Schichten sonst verwässern. -->
        <sonar.coverage.exclusions>
            src/main/java/de/frauenhaus/ui/**,
            src/main/java/de/frauenhaus/FrauenhausApplication.java
        </sonar.coverage.exclusions>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Server-seitiges Java-UI (ersetzt das Angular/npm-Frontend); zieht nur vaadin-core (freie Komponenten) -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>
        <!-- Dev-Mode-Tooling (Vite-Server, Live-Reload); optional = fliegt aus dem Produktions-Artefakt -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-envers</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- DB -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.13</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Schema-Migrationen (Baseline V1, Härtungen; Testdaten V5 nur im dev-Profil).
             Seit Boot 4 liegt die Flyway-AutoConfiguration im eigenen Modul spring-boot-flyway -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Reports: Excel (xlsx) und Word (docx) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <!-- Word-Binärformat (.dot/.doc) für die Vorlagen aus vorlagen/ -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockMvc-Unterstützung (@AutoConfigureMockMvc), seit Boot 4 eigenes Modul -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Wendet die Security-Filterkette in MockMvc-Tests an (@WithMockUser), seit Boot 4 eigenes Modul -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Entspricht der Standardkonfiguration von spring-boot-starter-parent
                 (Filterung der application*-Dateien mit @…@-Delimitern) und ergänzt
                 sie um zwei Ausschlüsse: db/init/* sind reine docker-initdb-Skripte,
                 die nur vom Compose-Stack gemountet und von der Anwendung nie
                 gelesen werden, und frontend/ ist Build-Eingabe des Vaadin-Plugins.
                 Beide liegen der Übersicht wegen hier, gehören aber nicht ins
                 Artefakt. db/migration und db/testdata lädt Flyway dagegen vom
                 Classpath. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/application*.yml</include>
                    <include>**/application*.yaml</include>
                    <include>**/application*.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/application*.yml</exclude>
                    <exclude>**/application*.yaml</exclude>
                    <exclude>**/application*.properties</exclude>
                    <exclude>db/init/**</exclude>
                    <!-- frontend/ ist Build-Eingabe des vaadin-maven-plugins
                         (siehe frontendDirectory unten). Das fertige Bundle
                         landet über den Produktions-Build unter META-INF/VAADIN
                         im Artefakt – die Quellen selbst gehören nicht hinein. -->
                    <exclude>frontend/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <configuration>
                    <!-- Abweichend vom Vaadin-Standard (src/main/frontend): alle
                         Nicht-Java-Quellen liegen in diesem Projekt gebündelt unter
                         src/main/resources. Die Angabe gilt für prepare-frontend und
                         build-frontend und wird über flow-build-info.json auch vom
                         Dev-Mode gelesen. -->
                    <frontendDirectory>${vaadin.frontend.directory}</frontendDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Testabdeckung für SonarQube: Agent beim Test-Lauf, XML-Report vor "verify" -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!-- Vaadin-Views und die Boot-Klasse fließen nicht in die Quote ein -->
                    <excludes>
                        <exclude>de/frauenhaus/ui/**</exclude>
                        <exclude>de/frauenhaus/FrauenhausApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Version fixiert, damit "mvn sonar:sonar" reproduzierbar bleibt -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.scanner.version}</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Produktions-Build des Vaadin-Frontends: ./mvnw package -Pproduction (lädt Node bei Bedarf selbst) -->
        <profile>
            <id>production</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <executions>
                            <execution>
                                <id>frontend</id>
                                <goals>
                                    <goal>build-frontend</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <forceProductionBuild>true</forceProductionBuild>
                            <frontendDirectory>${vaadin.frontend.directory}</frontendDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
